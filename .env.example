# ==============================================================================
# AMW100 CARPENTRY - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a .env.local para configurar tu entorno de desarrollo o
# configúralas en el panel de Vercel para producción.
# NUNCA subas archivos .env.local con claves reales al repositorio.

# ------------------------------------------------------------------------------
# 1. URL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio-definitivo.com (cuando esté definido)
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# 2. DATOS DE CONTACTO Y NEGOCIO (Completar con datos confirmados por el cliente)
# ------------------------------------------------------------------------------
# Teléfono de atención al cliente (ej. +34 600 000 000)
NEXT_PUBLIC_BUSINESS_PHONE=

# Email corporativo de atención (ej. info@amw100carpentry.es)
NEXT_PUBLIC_BUSINESS_EMAIL=

# Número de WhatsApp para el botón flotante (formato internacional sin espacios, ej. 34600000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Dirección fiscal / física
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_REGION=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_BUSINESS_COUNTRY=España
NEXT_PUBLIC_BUSINESS_HOURS=

# Datos legales (NIF/CIF y razón social para Avisos Legales)
NEXT_PUBLIC_BUSINESS_TAX_ID=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=

# ------------------------------------------------------------------------------
# 3. REDES SOCIALES (Opcional - solo si el cliente las facilita)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PINTEREST_URL=

# ------------------------------------------------------------------------------
# 4. SUPABASE (Opcional - para persistencia de contact_requests en base de datos)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anónima (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave Service Role (SOLO en servidor, NUNCA exponer al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 5. RESEND (Opcional - para envío de emails de notificación al recibir formularios)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=
